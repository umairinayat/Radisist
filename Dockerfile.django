FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /workspace

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libglib2.0-0 \
    libgl1 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    && rm -rf /var/lib/apt/lists/*

COPY . /workspace

RUN pip install --no-cache-dir -r /workspace/radisist/radisist_backend/requirements.txt

WORKDIR /workspace/radisist/radisist_backend

EXPOSE 7400

CMD ["python3", "manage.py", "runserver", "0.0.0.0:7400"]
